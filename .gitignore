# .gitignore genérico para Python
# --- Representantes de clase ---
*.json
# --- Entornos Virtuales ---
venv/
.venv/
env/
ENV/

# --- Archivos compilados y caché de módulos Python ---
__pycache__/
*.py[cod]
*$py.class

# --- Distribución y empaquetado de librerías ---
build/
dist/
*.egg-info/
.eggs/
